---
import { allChapters } from "../lib/chapters";
import { modules } from "../data/modules";

interface Props {
  path?: string;
}

const { path = "/" } = Astro.props;

const chapters = await allChapters();

const nav = [
  { href: "/", label: "Home" },
  { href: "/start", label: "Start" },
  { href: "/playground", label: "Playground" },
  { href: "/quiz-hub", label: "Quiz hub" },
  { href: "/code", label: "Code browser" },
  { href: "/glossary", label: "Glossary" },
];

const reference = [
  { href: "/reference/api", label: "API reference" },
  { href: "/reference/models", label: "Data models" },
  { href: "/reference/migrations", label: "Migrations" },
];

const referenceActive = path.startsWith("/reference/");

const pageLabels: Record<string, string> = {
  "/": "Home",
  "/start": "Start here",
  "/playground": "Playground",
  "/code": "Code browser",
  "/glossary": "Glossary",
  "/quiz-hub": "Quiz hub",
  "/reference/api": "API reference",
  "/reference/models": "Data models",
  "/reference/migrations": "Migrations",
};

interface Crumb {
  label: string;
  href?: string;
  current?: boolean;
}

let crumbs: Crumb[] = [];

const chapter = path.startsWith("/chapters/")
  ? chapters.find((c) => `/chapters/${c.id}` === path)
  : undefined;

if (chapter) {
  const m = modules.find((mod) => mod.key === chapter.module);
  const moduleFirst = chapters.find((c) => c.module === chapter.module);
  crumbs = [
    { label: "Inside Book a Slot", href: "/" },
    {
      label: `${m?.number ?? "Module"} · ${m?.label ?? chapter.module}`,
      href: moduleFirst ? `/chapters/${moduleFirst.id}` : "/",
    },
    { label: `Chapter ${String(chapter.chapter).padStart(2, "0")}`, current: true },
  ];
} else if (path.startsWith("/reference/")) {
  crumbs = [
    { label: "Inside Book a Slot", href: "/" },
    { label: "Reference", href: "/reference/api" },
    { label: pageLabels[path] ?? path.split("/").pop() ?? "Page", current: true },
  ];
} else {
  crumbs = [
    { label: "Inside Book a Slot", href: "/" },
    { label: pageLabels[path] ?? "Page", current: true },
  ];
}
---

<header class="sticky top-0 z-50 border-b border-slate-200 bg-amber-50/90 backdrop-blur">
  <div class="mx-auto flex w-full max-w-[1440px] items-center gap-3 px-4 py-2.5 lg:px-8">
    <a href="/" class="flex items-center gap-2 font-semibold tracking-tight text-slate-900" aria-label="Inside Book a Slot — home">
      <svg viewBox="0 0 24 24" class="h-5 w-5 text-indigo-700" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="3" y="4" width="18" height="17" rx="2.5" />
        <path d="M3 9h18M8 2v4M16 2v4" />
      </svg>
      <span>Inside Book a Slot</span>
    </a>

    <nav class="ml-auto hidden items-center gap-1 md:flex" aria-label="Primary">
      {nav.map((n) => {
        const active = n.href === "/" ? path === "/" : path === n.href || path.startsWith(n.href + "/");
        return (
          <a
            href={n.href}
            aria-current={active ? "page" : undefined}
            class:list={[
              "rounded-lg px-3 py-1.5 text-sm font-medium transition-colors",
              active ? "bg-indigo-50 text-indigo-700" : "text-slate-600 hover:bg-slate-100 hover:text-slate-900",
            ]}
          >
            {n.label}
          </a>
        );
      })}

      <div class="relative">
        <button
          type="button"
          id="reference-trigger"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="reference-menu"
          aria-current={referenceActive ? "page" : undefined}
          class:list={[
            "flex items-center gap-1 rounded-lg px-3 py-1.5 text-sm font-medium transition-colors",
            referenceActive ? "bg-indigo-50 text-indigo-700" : "text-slate-600 hover:bg-slate-100 hover:text-slate-900",
          ]}
        >
          Reference
          <svg viewBox="0 0 20 20" class="h-3.5 w-3.5 text-slate-500 transition-transform" data-chevron fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>
        <div
          id="reference-menu"
          role="menu"
          class="absolute right-0 top-full z-20 mt-1 hidden w-52 rounded-lg border border-slate-200 bg-white p-1.5 shadow-lg"
        >
          {reference.map((r) => (
            <a
              href={r.href}
              role="menuitem"
              aria-current={r.href === path ? "page" : undefined}
              class:list={[
                "block rounded-md px-3 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-indigo-700",
                r.href === path && "bg-indigo-50 font-semibold text-indigo-700",
              ]}
            >
              {r.label}
            </a>
          ))}
        </div>
      </div>
    </nav>

    <a
      href="https://github.com/maverickOG/book-a-slot"
      target="_blank"
      rel="noreferrer"
      class="ml-auto flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:border-indigo-300 hover:text-indigo-700 md:ml-2"
    >
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
        <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-1.93c-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.04-.72.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.24 3.34.95.1-.74.4-1.24.72-1.53-2.55-.29-5.23-1.28-5.23-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 015.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.73.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.38-5.25 5.66.41.36.78 1.06.78 2.14v3.17c0 .3.2.67.8.55A11.5 11.5 0 0023.5 12C23.5 5.65 18.35.5 12 .5z" />
      </svg>
      <span class="hidden lg:inline">repo</span>
    </a>
  </div>

  <nav class="flex items-center gap-1 overflow-x-auto border-t border-slate-100 px-4 py-1.5 md:hidden" aria-label="Primary mobile">
    {[...nav, ...reference].map((n) => {
      const active = n.href === "/" ? path === "/" : path === n.href || path.startsWith(n.href + "/");
      return (
        <a
          href={n.href}
          aria-current={active ? "page" : undefined}
          class:list={[
            "whitespace-nowrap rounded-md px-2.5 py-1 text-xs font-medium transition-colors",
            active
              ? "bg-indigo-600 font-semibold text-white"
              : "text-slate-600 hover:bg-slate-100 hover:text-slate-900",
          ]}
        >
          {n.label}
        </a>
      );
    })}
  </nav>

  <nav aria-label="Breadcrumb" class="border-t border-slate-100">
    <ol class="mx-auto flex w-full max-w-[1440px] flex-wrap items-center gap-x-1.5 gap-y-1 overflow-x-auto px-4 py-1.5 text-xs text-slate-500 lg:px-8">
      {crumbs.map((c) => (
        <li class="flex items-center gap-1.5 whitespace-nowrap">
          {c.href ? (
            <>
              <a href={c.href} class="rounded font-medium text-slate-600 hover:text-indigo-700 hover:underline">
                {c.label}
              </a>
              <span aria-hidden="true">/</span>
            </>
          ) : (
            <span aria-current="page" class="rounded font-semibold text-slate-800">
              {c.label}
            </span>
          )}
        </li>
      ))}
    </ol>
  </nav>
</header>

<script>
  const trigger = document.getElementById("reference-trigger");
  const menu = document.getElementById("reference-menu");
  const chevron = trigger?.querySelector("[data-chevron]");

  function setOpen(open: boolean) {
    trigger?.setAttribute("aria-expanded", String(open));
    menu?.classList.toggle("hidden", !open);
    chevron?.classList.toggle("rotate-180", open);
    if (open) {
      const first = menu?.querySelector('a[role="menuitem"]') as HTMLElement | null;
      first?.focus();
    }
  }

  trigger?.addEventListener("click", (e) => {
    // Keyboard activation (detail === 0) is handled by the keydown listener;
    // skipping it here prevents a toggle-open-then-close double fire.
    if (e.detail === 0) return;
    const isOpen = trigger.getAttribute("aria-expanded") === "true";
    setOpen(!isOpen);
  });

  trigger?.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown" || e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      setOpen(true);
    }
    if (e.key === "Escape") {
      setOpen(false);
      trigger?.focus();
    }
  });

  menu?.addEventListener("click", () => setOpen(false));

  document.addEventListener("click", (e) => {
    if (menu && trigger && !menu.contains(e.target as Node) && !trigger.contains(e.target as Node)) {
      setOpen(false);
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      setOpen(false);
      trigger?.focus();
    }
  });
</script>