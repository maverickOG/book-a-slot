---
interface Props {
  kind?: "note" | "tip" | "warn" | "danger";
  title?: string;
}

const { kind = "note", title } = Astro.props;

const styles = {
  note: { wrap: "border-indigo-200 bg-indigo-50/70", icon: "text-indigo-600", emoji: "💡" },
  tip: { wrap: "border-emerald-200 bg-emerald-50/70", icon: "text-emerald-600", emoji: "✅" },
  warn: { wrap: "border-amber-300 bg-amber-50/80", icon: "text-amber-600", emoji: "⚠️" },
  danger: { wrap: "border-rose-300 bg-rose-50/80", icon: "text-rose-600", emoji: "🚫" },
} as const;
---

<div class:list={["callout", styles[kind].wrap]}>
  <span class:list={["mt-0.5 shrink-0", styles[kind].icon]} aria-hidden="true">
    {styles[kind].emoji}
  </span>
  <div class="min-w-0">
    {title && <p class="mb-1 font-semibold text-slate-900">{title}</p>}
    <div class="space-y-2">
      <slot />
    </div>
  </div>
</div>