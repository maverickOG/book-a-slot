---
import AppShell from "../layouts/AppShell.astro";
---

<AppShell title="Not found · Inside Book a Slot" description="Page not found.">
  <article class="chapter-content">
    <div class="py-16 text-center">
      <p class="text-6xl font-bold text-indigo-200">404</p>
      <h1 class="mt-3 text-2xl font-bold text-slate-900">This page got a 404</h1>
      <p class="mx-auto mt-2 max-w-md text-slate-600">
        …which is exactly what this API returns when a booking doesn't exist, minus the
        missing-bearer-token 401.
      </p>
      <a href="/" class="mt-6 inline-block rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-indigo-700">
        Back to the home page
      </a>
    </div>
  </article>
</AppShell>