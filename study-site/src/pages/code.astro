---
import AppShell from "../layouts/AppShell.astro";
import Callout from "../components/ui/Callout.astro";

const files: Record<string, string> = import.meta.glob(
  "../code-snapshots/**/*",
  { query: "?raw", import: "default", eager: true },
);

interface Group {
  name: string;
  items: { rel: string; content: string }[];
}

const groups: Group[] = [];
for (const [abs, content] of Object.entries(files)) {
  const rel = abs.replace("../code-snapshots/", "");
  if (rel === "_MANIFEST.json") continue;
  const sep = rel.indexOf("/");
  const top = sep === -1 ? "(root)" : rel.slice(0, sep);
  let g = groups.find((x) => x.name === top);
  if (!g) {
    g = { name: top, items: [] };
    groups.push(g);
  }
  g.items.push({ rel, content });
}
groups.sort((a, b) => a.name.localeCompare(b.name));
groups.forEach((g) => g.items.sort((a, b) => a.rel.localeCompare(b.rel)));
const totalFiles = Object.keys(files).length - 1;
const totalLines = Object.entries(files).reduce(
  (sum, [, c]) => sum + c.split("\n").length,
  0,
);
---

<AppShell title="Code browser · Inside Book a Slot" description="Browse frozen copies of the real repository files.">
  <article class="chapter-content">
    <header class="page-header">
      <p class="page-eyebrow">Code browser</p>
      <h1 class="page-title">The repository, frozen</h1>
      <p class="page-lead">
        {totalFiles} files copied verbatim from the repo at the verified commits — the full
        app, migrations, tests, Docker and CI. Open any file below.
      </p>
    </header>

    <div class="mb-5 grid gap-3 sm:grid-cols-3">
      <div class="rounded-xl border border-slate-200 bg-white p-3">
        <p class="text-2xl font-bold text-indigo-700">{totalFiles}</p>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">files</p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-3">
        <p class="text-2xl font-bold text-indigo-700">{totalLines.toLocaleString()}</p>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">lines</p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-3">
        <p class="text-2xl font-bold text-indigo-700">e33d36f</p>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">app-code commit</p>
      </div>
    </div>

    {groups.map((g) => (
      <details class="mb-3 rounded-2xl border border-slate-200 bg-white" open={g.name === "app"}>
        <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-3">
          <span class="font-mono text-sm font-bold text-slate-800">{g.name}/</span>
          <span class="text-xs text-slate-400">{g.items.length} file{g.items.length === 1 ? "" : "s"}</span>
        </summary>
        <div class="space-y-2 border-t border-slate-100 px-5 py-4">
          {g.items.map((it) => (
            <details id={`file-${it.rel.replace(/[^a-zA-Z0-9._-]/g, "-")}`} class="rounded-xl border border-slate-100">
              <summary class="cursor-pointer list-none px-4 py-2 font-mono text-[13px] text-slate-600 hover:bg-slate-50">
                {it.rel}
              </summary>
              <pre class="overflow-x-auto border-t border-slate-100 bg-slate-950 px-4 py-3 text-[12px] leading-relaxed text-slate-200">
                <code class="whitespace-pre">{it.content}</code>
              </pre>
            </details>
          ))}
        </div>
      </details>
    ))}

    <Callout kind="note" title="Keep it frozen on purpose">
      These are <strong>copies for teaching</strong>, refreshed only by
      <code>npm run sync:code</code>. The live source of truth is the git repository —
      this page exists so you can read and quote files without switching context.
    </Callout>
  </article>
</AppShell>

<script>
  // Deep-link support: /code#app/models/booking.py opens that file and its group.
  const fileId = (rel: string) => `file-${rel.replace(/[^a-zA-Z0-9._-]/g, "-")}`;
  const openByHash = () => {
    const hash = decodeURIComponent(window.location.hash.replace(/^#/, ""));
    if (!hash) return;
    const target = document.getElementById(fileId(hash)) as HTMLDetailsElement | null;
    if (!target) return;
    // Open the file's group details, then the file details, then scroll to it.
    const group = target.closest("details[class*='mb-3']") as HTMLDetailsElement | null;
    if (group && !group.open) group.open = true;
    if (!target.open) target.open = true;
    requestAnimationFrame(() => target.scrollIntoView({ block: "start" }));
  };
  window.addEventListener("hashchange", openByHash);
  openByHash();
</script>