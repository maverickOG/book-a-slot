---
import AppShell from "../../layouts/AppShell.astro";
import { endpoints } from "../../data/endpoints";
import Callout from "../../components/ui/Callout.astro";

const methodTone: Record<string, string> = {
  GET: "bg-emerald-100 text-emerald-700",
  POST: "bg-indigo-100 text-indigo-700",
  PUT: "bg-amber-100 text-amber-700",
  DELETE: "bg-rose-100 text-rose-700",
};
---

<AppShell title="API reference · Inside Book a Slot" description="Every route the Book a Slot API exposes, with auth and status codes.">
  <article class="chapter-content">
    <header class="page-header">
      <p class="page-eyebrow">Reference</p>
      <h1 class="page-title">API reference</h1>
      <p class="page-lead">
        All 12 routes across three routers, grounded in the route tables
        (<code>app/routers/*.py</code>).
      </p>
    </header>

    <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white">
      <table class="w-full min-w-[56rem] text-left text-sm">
        <thead>
          <tr class="border-b border-slate-200 bg-slate-50 text-xs font-semibold uppercase tracking-wide text-slate-500">
            <th class="px-4 py-3">Method</th>
            <th class="px-4 py-3">Path</th>
            <th class="px-4 py-3">Purpose</th>
            <th class="px-4 py-3">Auth</th>
            <th class="px-4 py-3">Key outcomes</th>
            <th class="px-4 py-3">Source</th>
          </tr>
        </thead>
        <tbody>
          {endpoints.map((e) => (
            <tr class="border-b border-slate-100 align-top last:border-0">
              <td class="px-4 py-3">
                <span class={`rounded px-1.5 py-0.5 font-mono text-[11px] font-bold ${methodTone[e.method]}`}>
                  {e.method}
                </span>
              </td>
              <td class="whitespace-nowrap px-4 py-3 font-mono text-[13px] text-slate-800">{e.path}</td>
              <td class="px-4 py-3 text-slate-600">{e.title}</td>
              <td class="px-4 py-3 text-[13px] text-slate-600">{e.auth}</td>
              <td class="px-4 py-3">
                <ul class="space-y-1 text-[13px] text-slate-600">
                  {e.responses.map((r) => (
                    <li>· {r}</li>
                  ))}
                </ul>
              </td>
              <td class="px-4 py-3 font-mono text-[12px] text-slate-400">{e.source}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <Callout kind="tip" title="Try them against the real docs">
      <code>docker compose up --build</code>, then open <code>http://localhost:8000/docs</code> —
      every row above is clickable there (generated by FastAPI from the same type hints).
    </Callout>

    <p class="text-sm text-slate-500">
      The interactive version lives on the <a href="/playground" class="font-medium text-indigo-700 underline decoration-indigo-300 underline-offset-2">Playground</a> page.
    </p>
  </article>
</AppShell>